ups, and the code using untrusted strings as the second argument of `.replace`. This problem has been fixed in `@babel/helpers` and `@babel/runtime` 7.26.10 and 8.0.0-alpha.17. It's likely that individual users do not directly depend on `@babel/helpers`, and instead depend on `@babel/core` (which itself depends on `@babel/helpers`). Upgrading to `@babel/core` 7.26.10 is not required, but it guarantees use of a new enough `@babel/helpers` version. Note that just updating Babel dependencies is not enough; one will also need to re-compile the code. No known workarounds are available.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":6.2,"exploitabilityScore":2.6,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-27789","epss":0.00082,"percentile":0.23764,"date":"2026-04-29"}],"cwes":[{"cve":"CVE-2025-27789","cwe":"CWE-1333","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"@babel/runtime","version":"^7.25.6"}},"found":{"vulnerabilityID":"GHSA-968p-4wvh-cqc8","versionConstraint":"<7.26.10 (semantic)"},"fix":{"suggestedVersion":"7.26.10"}}],"artifact":{"id":"npm-babel-runtime-7.25.6-3959b2","name":"@babel/runtime","version":"^7.25.6","type":"npm","locations":null,"language":"javascript","licenses":[],"cpes":[],"purl":"pkg:npm/%40babel/runtime@%5E7.25.6","upstreams":[]}},{"vulnerability":{"id":"GHSA-968p-4wvh-cqc8","dataSource":"https://github.com/advisories/GHSA-968p-4wvh-cqc8","namespace":"github:language:javascript","severity":"Medium","urls":["https://github.com/babel/babel/security/advisories/GHSA-968p-4wvh-cqc8","https://github.com/babel/babel/pull/17173","https://github.com/babel/babel/commit/d5952e80c0faa5ec20e35085531b6e572d31dad4","https://nvd.nist