Score":5.4,"exploitabilityScore":2.9,"impactScore":2.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-69693","epss":0.00016,"percentile":0.0351,"date":"2026-04-20"}],"cwes":[{"cve":"CVE-2025-69693","cwe":"CWE-125","source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","type":"Secondary"}],"fix":{"versions":[],"state":""},"advisories":[],"risk":0.008320000000000001},"relatedVulnerabilities":[],"matchDetails":[{"type":"cpe-match","matcher":"stock-matcher","searchedBy":{"namespace":"nvd:cpe","cpes":["cpe:2.3:a:ffmpeg:ffmpeg:8.0.1:*:*:*:*:*:*:*"],"package":{"name":"ffmpeg","version":"8.0.1"}},"found":{"vulnerabilityID":"CVE-2025-69693","versionConstraint":"= 8.0,= 8.0.1 (unknown)","cpes":["cpe:2.3:a:ffmpeg:ffmpeg:*:*:*:*:*:*:*:*"]}}],"artifact":{"id":"Package-binary-ffmpeg-1d3404a8b68a526d","name":"ffmpeg","version":"8.0.1","type":"UnknownPackage","locations":null,"language":"","licenses":[],"cpes":["cpe:2.3:a:ffmpeg:ffmpeg:8.0.1:*:*:*:*:*:*:*"],"purl":"pkg:generic/ffmpeg@8.0.1","upstreams":[]}},{"vulnerability":{"id":"GHSA-6vgw-5pg2-w6jp","dataSource":"https://github.com/advisories/GHSA-6vgw-5pg2-w6jp","namespace":"github:language:python","severity":"Low","urls":["https://nvd.nist.gov/vuln/detail/CVE-2026-1703","https://github.com/pypa/pip/pull/13777","https://github.com/pypa/pip/commit/8e227a9be4faa9594e05d02ca05a413a2a4e7735","https://mail.python.org/archives/list/security-announce@python.org/thread/WIEA34D4TABF2UNQJAOMXKCICSPBE2DJ"],"description":"pip Path Traversal vulnerability","cvss":[{"type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:A/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N","metrics":{"baseScore":2},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-1703","epss":0.00026,"percentile":0.06996,"date":"2026-04-20"}],"cwes":[{"cve":"CVE-2026-1703","cwe":"CWE-22","source":"cna@python.org","type":"Secondary"}],"fix":{"versions":["26.0"],"state":"fixed","available":[{"version":"26.0","date":"2026-02-03","kind":"first-observed"}]},"advisories":[],"risk":0.0065}